# ==========================================
# CAMPUS CONNECT ENVIRONMENT CONFIGURATION
# ==========================================

# Port the Express backend API runs on (default: 5000)
PORT=5000

# ==========================================
# SUPABASE DATABASE INTEGRATION
# ==========================================
# To connect your Supabase database:
# 1. Go to https://supabase.com -> Open your project
# 2. Click "Project Settings" (gear icon) -> "API"
# 3. Copy "Project URL" and paste below:
SUPABASE_URL=

# 4. Copy "anon / public" API key (or "service_role" secret key) and paste below:
SUPABASE_KEY=

# Note: If SUPABASE_URL is left empty, Campus Connect automatically
# runs in resilient Local Memory Mode with complete seed data!
